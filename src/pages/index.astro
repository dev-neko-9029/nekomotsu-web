>
  <source
    src="https://cdn.pixabay.com/download/audio/2022/05/27/audio_1808fbf07a.mp3?filename=lofi-study-112191.mp3"
    type="audio/mpeg"
  />
</audio>


<script>
  /* ------------------------
     POMODORO
  ------------------------ */

  const display =
    document.getElementById("timer");

  const modeDisplay =
    document.getElementById("mode");

  const toggle =
    document.getElementById("timer-toggle");

  const reset =
    document.getElementById("timer-reset");

  const timerIcon =
    document.getElementById("timer-icon");


  const times = {
    focus: 25 * 60,
    break: 5 * 60
  };


  let currentMode = "focus";

  let seconds =
    times[currentMode];

  let running = true;


  function renderTimer() {

    const minutes =
      Math.floor(seconds / 60);

    const remaining =
      seconds % 60;


    if (display) {

      display.textContent =
        `${String(minutes).padStart(2, "0")}:${String(remaining).padStart(2, "0")}`;

    }


    if (modeDisplay) {

      modeDisplay.textContent =
        currentMode;

    }


    if (timerIcon) {

      timerIcon.setAttribute(
        "d",
        running
          ? "M9 5v14M15 5v14"
          : "m8 5 11 7-11 7V5Z"
      );

    }

  }


  function changeMode() {

    currentMode =
      currentMode === "focus"
        ? "break"
        : "focus";

    seconds =
      times[currentMode];

  }


  setInterval(() => {

    if (!running) return;


    if (seconds > 0) {

      seconds--;

    } else {

      changeMode();

    }


    renderTimer();

  }, 1000);


  toggle?.addEventListener(
    "click",
    () => {

      running = !running;

      renderTimer();

    }
  );


  reset?.addEventListener(
    "click",
    () => {

      seconds =
        times[currentMode];

      running = true;

      renderTimer();

    }
  );


  renderTimer();



  /* ------------------------
     LO-FI
  ------------------------ */

  const audio =
    document.getElementById(
      "lofi-player"
    );

  const audioButton =
    document.getElementById(
      "audio-btn"
    );

  const audioLabel =
    document.getElementById(
      "audio-label"
    );


  if (
    audio instanceof HTMLAudioElement
  ) {

    audio.volume = 0.16;


    function updateAudioUI(
      playing,
      blocked = false
    ) {

      if (audioButton) {

        audioButton.dataset.playing =
          playing
            ? "true"
            : "false";

      }


      if (audioLabel) {

        audioLabel.textContent =
          playing
            ? "Lo-fi on"
            : blocked
              ? "Activar"
              : "Lo-fi off";

      }

    }


    async function startAudio() {

      try {

        await audio.play();

        updateAudioUI(true);

        return true;

      } catch {

        /*
         * Chrome/Safari pueden bloquear
         * autoplay con sonido.
         */

        updateAudioUI(
          false,
          true
        );

        return false;

      }

    }


    startAudio();


    /*
     * Si autoplay fue bloqueado,
     * arrancamos en la primera
     * interacción real.
     */

    document.addEventListener(
      "pointerdown",
      async (event) => {

        if (!audio.paused) return;


        const target =
          event.target;


        /*
         * El botón tiene su propia lógica.
         * Evitamos arrancar + pausar
         * en el mismo click.
         */

        if (
          target instanceof Element &&
          target.closest("#audio-btn")
        ) {
          return;
        }


        await startAudio();

      },
      {
        once: true
      }
    );


    audioButton?.addEventListener(
      "click",
      async () => {

        if (audio.paused) {

          await startAudio();

        } else {

          audio.pause();

          updateAudioUI(false);

        }

      }
    );


    audio.addEventListener(
      "play",
      () =>
        updateAudioUI(true)
    );


    audio.addEventListener(
      "pause",
      () =>
        updateAudioUI(false)
    );

  }
</script>

